<?xml version="1.0"?>
<!--
  2-Finger Parallel Gripper Xacro
  ================================
  Defines a simple parallel-jaw gripper as a reusable xacro:macro.
  Parent is typically wrist_2_link.

  Kinematic chain:
    gripper_base_link  (fixed mount, cylinder Ø50×40 mm)
    ├── left_finger_joint  (prismatic, +Y, 0–40 mm)
    │   left_finger_link   (box 30×20×80 mm)
    └── right_finger_joint (prismatic, -Y, 0–40 mm)
        right_finger_link  (box 30×20×80 mm)

  Opening convention:
    position = 0.0   → closed (fingers touching at centre)
    position = 0.04  → fully open (40 mm gap per side, 80 mm total)

  ros2_control interfaces:
    Both finger joints: position command + position/velocity state
    Commanded symmetrically by the gripper_controller (JointTrajectoryController).

  Phase 3 hook:
    A depth camera (RGBD) can be attached as a child of wrist_2_link or
    gripper_base_link — add the sensor macro here when Phase 3 is ready.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== MATERIALS ==================== -->
  <material name="gripper_silver">
    <color rgba="0.80 0.80 0.85 1.0"/>
  </material>
  <material name="gripper_rubber">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <!-- ==================== GRIPPER MACRO ==================== -->
  <xacro:macro name="gripper_macro" params="parent xyz:='0 0 0' rpy:='0 0 0'">

    <!-- ── gripper_base_link ── cylindrical body connecting to wrist flange ── -->
    <link name="gripper_base_link">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.04"/>
        </geometry>
        <material name="gripper_silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <!-- m=0.2 kg, cylinder r=0.025, l=0.04 -->
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.000071" ixy="0" ixz="0"
                 iyy="0.000071" iyz="0"
                 izz="0.000063"/>
      </inertial>
    </link>

    <!-- Fixed joint: mounts gripper onto the wrist tool flange -->
    <joint name="gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- ── left_finger_link ── slides in the +Y direction to open ── -->
    <link name="left_finger_link">
      <visual>
        <origin xyz="0.015 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.08"/>
        </geometry>
        <material name="gripper_rubber"/>
      </visual>
      <collision>
        <origin xyz="0.015 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <!-- m=0.05 kg, box 0.03×0.02×0.08 -->
        <origin xyz="0.015 0 0.04" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.000029" ixy="0" ixz="0"
                 iyy="0.000027" iyz="0"
                 izz="0.000005"/>
      </inertial>
    </link>

    <!-- left_finger_joint: prismatic, slides +Y to open left finger -->
    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="left_finger_link"/>
      <origin xyz="0 0.01 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="20.0" velocity="0.2"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- ── right_finger_link ── slides in the -Y direction to open ── -->
    <link name="right_finger_link">
      <visual>
        <origin xyz="0.015 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.08"/>
        </geometry>
        <material name="gripper_rubber"/>
      </visual>
      <collision>
        <origin xyz="0.015 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.015 0 0.04" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.000029" ixy="0" ixz="0"
                 iyy="0.000027" iyz="0"
                 izz="0.000005"/>
      </inertial>
    </link>

    <!-- right_finger_joint: prismatic, slides -Y (commanded as positive = open) -->
    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="right_finger_link"/>
      <origin xyz="0 -0.01 0.04" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>  <!-- negative Y axis: positive command moves finger outward -->
      <limit lower="0.0" upper="0.04" effort="20.0" velocity="0.2"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- ================================================================ -->
    <!-- ros2_control block — gripper finger hardware interfaces           -->
    <!-- ================================================================ -->
    <ros2_control name="GripperSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="left_finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.04</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.04</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <!-- ================================================================ -->
    <!-- Gazebo material overrides                                          -->
    <!-- ================================================================ -->
    <gazebo reference="gripper_base_link">
      <visual>
        <material>
          <ambient>0.80 0.80 0.85 1</ambient>
          <diffuse>0.80 0.80 0.85 1</diffuse>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="left_finger_link">
      <visual>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <!-- Gripper contact friction — high to grip objects -->
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>

    <gazebo reference="right_finger_link">
      <visual>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>

  </xacro:macro>

</robot>
