<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robot">
  <!-- URDF: Defines robot structure (links and joints)
       Tree: base_link → chassis, left_wheel, right_wheel, caster_wheel
       Links: physical parts; Joints: connections (fixed or rotating)
  -->

  <!-- ==================== PROPERTIES ==================== -->
  <!-- Robot chassis dimensions (meters) -->
  <xacro:property name="base_width" value="0.3"/>
  <xacro:property name="base_length" value="0.4"/>
  <xacro:property name="base_height" value="0.15"/>

  <!-- Wheel dimensions and placement -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_ygap" value="0.175"/>  <!-- lateral distance from center -->
  <xacro:property name="wheel_zoff" value="0.05"/>   <!-- height from ground -->
  <xacro:property name="wheel_xoff" value="0.1"/>    <!-- forward position -->

  <!-- ==================== LINKS ==================== -->
  <!-- Reference frame for entire robot (no geometry) -->
  <link name="base_link">
  </link>

  <!-- Robot body -->
  <link name="chassis">
    <visual>
      <!-- Center box on base_link -->
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
      </material>
    </visual>
  </link>

  <!-- ==================== JOINTS ==================== -->
  <!-- Attach chassis to base_link -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="-0.1 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== MACROS ==================== -->
  <!-- Wheel template macro (prefix: wheel name, y_reflect: ±1 for left/right) -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <!-- Rotate cylinder to lie flat (default: along Z-axis) -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
    </link>

    <!-- Spinning joint (continuous = unlimited rotation) -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- Position: forward(x), mirrored sideways(y), up(z) -->
      <origin xyz="${wheel_xoff} ${y_reflect * wheel_ygap} ${wheel_zoff}" rpy="0 0 0"/>
      <!-- Rotate around Y-axis -->
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- ==================== INSTANTIATION ==================== -->
  <!-- Create left and right wheels -->
  <xacro:wheel prefix="left" y_reflect="1" />
  <xacro:wheel prefix="right" y_reflect="-1" />

</robot>
